  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "electron-updater": "^6.8.11",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
