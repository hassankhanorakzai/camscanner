{
  "name": "smartscan",
  "productName": "SmartScan",
  "version": "1.0.0",
  "description": "SmartScan – offline document scanner & manager with named collections and direct local storage",
  "main": "src/main/main.js",
  "author": "SmartScan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "node test/e2e/run.js",
    "icons": "node scripts/make-icons.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "electron-updater": "^6.8.11",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.smartscan.desktop",
    "productName": "SmartScan",
    "copyright": "Copyright © SmartScan",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!node_modules/@techstark/opencv-js/dist/src/**",
      "!node_modules/@techstark/opencv-js/src/**",
      "!node_modules/pdf-lib/es/**",
      "!node_modules/pdf-lib/src/**",
      "!node_modules/pdf-lib/dist/**",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "SmartScan",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SmartScan",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "SmartScan-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hassankhanorakzai",
        "repo": "camscanner",
        "releaseType": "release"
      }
    ]
  }
}
