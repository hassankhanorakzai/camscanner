{
  "name": "smartscan",
  "productName": "SmartScan",
  "version": "1.0.0",
  "description": "SmartScan – offline document scanner & manager with named collections and direct local storage",
  "main": "src/main/main.js",
  "author": "SmartScan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.js",
